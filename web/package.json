{
  "name": "disk-usage-analyzer-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Disk Usage Analyzer 3D studio",
  "author": "Khotso Tsoaela",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3847",
    "desktop": "electron electron/main.cjs",
    "stage": "node scripts/stage-studio.cjs",
    "pack": "npm run build && npm run stage && electron-builder --win --publish never"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.khotso.disk-usage-analyzer",
    "productName": "Disk Usage Analyzer 3D",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "studio-bundle",
        "to": "studio"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Disk Usage Analyzer 3D",
      "artifactName": "DiskUsageAnalyzer3D-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DiskUsageAnalyzer3D-${version}-portable.${ext}"
    }
  }
}
